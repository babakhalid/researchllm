{
  "name": "ai-researcher",
  "version": "1.0.0",
  "description": "Autonomous AI research platform with GPU-accelerated experiments",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"api,vite\" -c \"yellow,cyan\" \"npm run api\" \"npm run frontend:dev\"",
    "api": "npm run --prefix server dev",
    "frontend:dev": "npm run --prefix frontend dev",
    "frontend:build": "npm run --prefix frontend build",
    "frontend:lint": "npm run --prefix frontend lint",
    "frontend:typecheck": "npm run --prefix frontend typecheck",
    "server:build": "npm run --prefix server build",
    "build": "npm run server:build && npm run frontend:build",
    "install:all": "pip install -r requirements.txt && npm install --prefix server && npm install --prefix frontend",
    "setup": "npm run install:all",
    "clean": "rm -rf server/node_modules server/dist frontend/node_modules frontend/dist __pycache__ .pytest_cache",
    "start": "npm run --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "research",
    "machine-learning",
    "agents",
    "vite",
    "react",
    "fastapi"
  ],
  "license": "MIT"
}
