{
  "name": "ai-researcher",
  "version": "1.0.0",
  "description": "Autonomous AI research platform with GPU-accelerated experiments",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"api,vite\" -c \"yellow,cyan\" \"npm run api\" \"vite\"",
    "api": "npm run --prefix server dev",
    "server:dev": "npm run --prefix server dev",
    "server:build": "npm run --prefix server build",
    "server:start": "npm run --prefix server start",
    "build": "tsc -b && vite build && npm run server:build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "install:all": "pip install -r requirements.txt && npm install && npm install --prefix server",
    "setup": "npm run install:all",
    "clean": "rm -rf node_modules dist server/node_modules server/dist backup/__pycache__ .pytest_cache",
    "start": "npm run server:start"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "research",
    "machine-learning",
    "agents",
    "vite",
    "react"
  ],
  "license": "MIT"
}
